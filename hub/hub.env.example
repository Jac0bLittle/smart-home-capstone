# Copy to /etc/smarthome/hub.env (make_passwords.sh writes the MQTT part).
# Keep this file out of Git: it holds passwords.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=hub
MQTT_PASS=

# Logger
LOG_DB=/var/lib/smarthome/log.db
RETENTION_DAYS=30

# Alerts (sheet section 6)
DRY_RUN=0
ALERT_COOLDOWN_S=300
OFFLINE_GRACE_S=60
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=            # long random name, e.g. output of: openssl rand -hex 12
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=             # Gmail sender address
SMTP_PASS=             # Gmail app password (needs 2-step verification)
EMAIL_TO=              # comma-separated recipients
