[Unit]
Description=Smart Home MQTT logger (SQLite, 30-day history)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=smarthome
EnvironmentFile=/etc/smarthome/hub.env
WorkingDirectory=/opt/smarthome/services
ExecStart=/usr/bin/python3 -u /opt/smarthome/services/mqtt_logger.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
